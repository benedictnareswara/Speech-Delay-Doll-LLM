# SpeechLLM — Environment Configuration
#
# Copy this file to .env and adjust for your setup.
# On the Orange Pi, the actual config lives at /etc/speechllm/device.env
# (installed by deploy/orangepi/install.sh).
#
# These defaults are tuned for development on a laptop.

# ── Install location (device only) ──────────────────────────
# SPEECHLLM_ROOT=/opt/speechllm

# ── Offline operation (device only) ─────────────────────────
# HF_HOME=/opt/speechllm/models/hf
# HF_HUB_OFFLINE=1

# ── Microphone ──────────────────────────────────────────────
# Substring of the device name from `python -m speechllm_device --list-devices`
# AUDIO_INPUT_DEVICE=USB
# Set to your mic's native rate if it doesn't support 16 kHz (0 = use 16 kHz)
# AUDIO_CAPTURE_RATE=48000

# ── Voice Activity Detection ────────────────────────────────
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=150
# VAD_MAX_SPEECH_MS=3000
# VAD_SILENCE_MS=400

# ── Speech Recognition ─────────────────────────────────────
# STT_MODEL_SIZE=tiny
# STT_COMPUTE_TYPE=int8
# STT_THREADS=4
# STT_LANGUAGE=id
# STT_MAX_NEW_TOKENS=16

# ── DFPlayer (device only) ─────────────────────────────────
# AUDIO_SINK=dfplayer
# DFPLAYER_PORT=/dev/ttyS5
# DFPLAYER_VOLUME=22
# DFPLAYER_BUSY_GPIO=256
# DFPLAYER_GPIOCHIP=gpiochip0

# ── Pipeline ───────────────────────────────────────────────
# SPEAK_COOLDOWN_MS=300
# THINKING_CHIME_MIN_GAP_MS=5000
# PLAYBACK_TIMEOUT_S=15
